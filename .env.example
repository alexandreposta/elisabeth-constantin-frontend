# =====================================================================
# Variables d'environnement build-time (Vite les inline dans le bundle).
# Copier vers `.env` localement. Aucune de ces valeurs n'est secrète :
# - clé Stripe publishable (publique par design)
# - Cloudinary cloud name + unsigned upload preset (publics)
# Mais elles changent par environnement — ne pas commiter de `.env`.
# =====================================================================

# URL absolue de l'API backend (consommée par fetch côté navigateur).
VITE_API_URL=http://localhost:8000

# Stripe — clé publishable (commence par pk_test_ ou pk_live_).
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_me

# Cloudinary — upload signé via preset unsigned (admin uniquement).
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
